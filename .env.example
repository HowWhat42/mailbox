# Google OAuth "Desktop app" client (console.cloud.google.com > APIs & Services > Credentials)
# Enable the Gmail API and Google Calendar API on the project.
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=

# Microsoft (Outlook.com, Hotmail, Live, Microsoft 365) public client (entra.microsoft.com > App registrations)
# Accounts: "any Entra ID tenant + personal Microsoft accounts"; platform "Mobile and desktop applications",
# redirect URI http://localhost; API permissions: Office 365 Exchange Online IMAP.AccessAsUser.All + SMTP.Send (delegated).
MAIN_VITE_MICROSOFT_CLIENT_ID=

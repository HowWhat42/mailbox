{
  "name": "mailbox",
  "version": "0.1.1",
  "private": true,
  "description": "Client mail + calendrier desktop",
  "author": "Mailbox",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:e2e": "electron-vite build && node tests/e2e.mjs",
    "test:e2e:calendar": "electron-vite build && node tests/e2e-calendar.mjs",
    "test:e2e:responsive": "electron-vite build && node tests/e2e-responsive.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "test:e2e:triage": "electron-vite build && node tests/e2e-triage.mjs",
    "test:e2e:accounts": "electron-vite build && node tests/e2e-accounts.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:e2e:reader": "electron-vite build && node tests/e2e-reader.mjs",
    "check": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && oxlint --deny-warnings && oxfmt --check",
    "test:e2e:offline": "electron-vite build && node tests/e2e-offline.mjs",
    "test:e2e:update": "electron-vite build && node tests/e2e-update.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ical.js": "^2.2.1",
    "imapflow": "^2.12.1",
    "mailparser": "^3.14.5",
    "nodemailer": "^10.6.0",
    "tsdav": "^2.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.18",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.73.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  },
  "packageManager": "pnpm@11.1.1",
  "build": {
    "appId": "app.mailbox.desktop",
    "productName": "Mailbox",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "asarUnpack": [
      "resources/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mailbox",
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HowWhat42",
        "repo": "mailbox",
        "releaseType": "release"
      }
    ]
  },
  "productName": "Mailbox"
}
